# DorkFi Harbormaster — copy to .env and fill in values

# Telegram alerts (optional — leave blank to disable)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Algorand node (for tx building/broadcasting)
ALGOD_TOKEN=
ALGOD_SERVER=https://mainnet-api.voi.nodely.dev
ALGOD_PORT=443

# Execution mode: "alert" (notify only) or "execute" (auto-repay/collateral)
MODE=alert

# Harbormaster wallet mnemonic (only needed in execute mode)
# This wallet must hold funds to act on behalf of watched wallets
# In execute mode with repay_on_behalf, this wallet pays the debt
GUARDIAN_MNEMONIC=
